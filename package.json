  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardolecdt/edusites-bandeiras-paises.git"
  },
  "bugs": {
    "url": "https://github.com/eduardolecdt/edusites-bandeiras-paises/issues"
  },
  "keywords": [
    "javascript",
    "bandeiras",
    "paises",
    "flags",
    "countries",
    "svg",
    "icons",
    "iso-3166",
    "ddi",
    "telefone",
    "edusites",
    "lecdt",
    "nuxt",
    "vue",
    "ui"
  ],
  "scripts": {
    "gerar": "node scripts/gerar.mjs",
